---
import "../styles/style.css";
import MainLayout from "../layouts/MainLayout.astro";
import Videoafspiller from "../components/Videoafspiller.astro";
import OneVideo from "../components/OneVideo.astro";
---

<MainLayout title="Barselona | Videoer">
  <section>
    <Videoafspiller />
  </section>

  <section class="videoer_galleri">
    <OneVideo image="https://espi0001.github.io/billeder/reallove.webp" loading="lazy" />
    <OneVideo image="https://espi0001.github.io/billeder/lydenaflivetlive.webp" loading="lazy" />
    <OneVideo image="https://espi0001.github.io/billeder/menneskemodmenneske.webp" loading="lazy" />
    <OneVideo image="https://espi0001.github.io/billeder/ingenkanloebelive.webp" loading="lazy" />
    <OneVideo image="https://espi0001.github.io/billeder/endeloesedroemme.webp" loading="lazy" />
    <OneVideo image="https://espi0001.github.io/billeder/fangetlive.webp" loading="lazy" />
    <OneVideo image="https://espi0001.github.io/billeder/landsby.webp" loading="lazy" />
    <OneVideo image="https://espi0001.github.io/billeder/minenesterus.webp" loading="lazy" />
    <OneVideo image="https://espi0001.github.io/billeder/endagminde.webp" loading="lazy" />
    <OneVideo image="https://espi0001.github.io/billeder/vierherikke.webp" loading="lazy" />
    <OneVideo image="https://espi0001.github.io/billeder/ildebrand.webp" loading="lazy" />
    <OneVideo image="https://espi0001.github.io/billeder/northside.webp" loading="lazy" />
    <OneVideo image="https://espi0001.github.io/billeder/forfoermig.webp" loading="lazy" />
    <OneVideo image="https://espi0001.github.io/billeder/frawienlive.webp" loading="lazy" />
    <OneVideo image="https://espi0001.github.io/billeder/fridag.webp" loading="lazy" />
    <OneVideo image="https://espi0001.github.io/billeder/etaar.webp" loading="lazy" />
    <OneVideo image="https://espi0001.github.io/billeder/densidstesang.webp" loading="lazy" />
    <OneVideo image="https://espi0001.github.io/billeder/barcelona.webp" loading="lazy" />
  </section>
</MainLayout>

<style>
  .hero_items {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 80px;
  }
  .videoafspiller {
    padding-bottom: 32px;
  }
  .videoer_galleri,
  .video {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 22px;
    justify-content: center;
  }
  .produkter {
    display: grid;
    grid-template-columns: 1fr 1fr;
    justify-content: center;
    gap: 22px;
  }

  /* ___________________________ TABLET  ___________________________*/
  @media screen and (min-width: 768px) {
    .videoer_galleri,
    .video {
      grid-template-columns: 1fr 1fr 1fr;
      gap: 32px;
    }
    .produkter {
      grid-template-columns: 1fr 1fr 1fr;
      gap: 32px;
    }
  }

  /* ___________________________ DESKTOP  ___________________________*/
  @media screen and (min-width: 1024px) {
    .videoer_galleri {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr 1fr;
    }
    .produkter {
      grid-template-columns: 1fr 1fr 1fr 1fr;
    }
  }
</style>
