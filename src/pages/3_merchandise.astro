---
import "../styles/style.css";
import MainLayout from "../layouts/MainLayout.astro";
import Header2 from "../components/Header2.astro";
import Produkt from "../components/Produkt.astro";
import Filter from "../components/Filter.astro";

const apiUrl = "https://orihtpvviiwcpmwzboqr.supabase.co/rest/v1/ekamen";
const apiKey = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im9yaWh0cHZ2aWl3Y3Btd3pib3FyIiwicm9sZSI6ImFub24iLCJpYXQiOjE3MTYzNjY0NzEsImV4cCI6MjAzMTk0MjQ3MX0.D3VmybLu_cJTAhpmkfHnKtssujUzP4qg3XDV1owo6Cw";

let data = []; // Laver en variabel med "data" og laver den til et tomt array.

// prøver at hente data fra apiUrl og apiKey
try {
  const response = await fetch(apiUrl, {
    method: "GET",
    headers: {
      apikey: apiKey,
    },
  });

  console.log("Response status:", response.status); // Tjekker status på response

  data = await response.json(); // konverterer response til json og lagrer i variabel "data"

  console.log("Fetched data:", data); // Laver en console.log på fetched data

  if (!Array.isArray(data)) {
    throw new Error("Fetched data is not an array");
  }
} catch (error) {
  console.error("Error fetching or processing data:", error);
  data = []; // Sørger for at datan er en tom array, hvis der sker fejl (error)
}
---

<MainLayout title="Barselona | Merchandise">
  <section class="hero_items">
    <Header2 header1="Merchandise" />
  </section>

  <section>
    <article class="filter_ting">
      <div class="filter">
        <a class="filterbutton active" data-filter="all">Se alt</a>

        <!-- data-filter er et attribut, som vi bruger til at filtrere data. -->
        <a class="filterbutton" data-filter="Tøj">Tøj</a>

        <a class="filterbutton" data-filter="Tilbehør">Tilbehør</a>

        <a class="filterbutton" data-filter="Vinyl">Vinyl</a>
      </div>

      <div>
        <p class="antal_produkter">31 produkter</p>
      </div>
    </article>

    <article class="produkter">
      {data.length > 0 ? data.map((product) => <Produkt id={product.id} images={product.image} name={product.name} type2={product.type2} price={product.price} type={product.type} />) : <p>No products available.</p>}
    </article>
  </section>

  <script>
    const knapper = document.querySelectorAll(".filterbutton");

    // løber array igennem og kalder funktionen filterBy for hver element
    knapper.forEach((knap) => {
      knap.addEventListener("click", () => filterBy(knap));
    });

    // Filtrerer, viser/skjuler baseret på valgt filter
    function filterBy(clickedKnap) {
      knapper.forEach((knap) => knap.classList.remove("active"));

      // Klikket knap får .active klassen
      clickedKnap.classList.add("active");

      // Læser data.filter
      const type = clickedKnap.dataset.filter;

      // Laver en variable
      let antalProdukter = 0;

      // Løber igennem alle produkter
      document.querySelectorAll("article.product").forEach((article) => {
        // Undersøger om data-type er = ens eller om det er "all"
        if (article.dataset.type === type || type === "all") {
          antalProdukter++; // Matcher filter = tæller én op

          console.log(article.dataset.type) + type; // Laver en console.log

          article.classList.remove("hide"); // Fjerner ".hide" hvis data-type = ens
        } else {
          article.classList.add("hide"); // Tilføjer ".hide" hvis data-type ikke = ens
        }

        document.querySelector(".antal_produkter").innerHTML = antalProdukter + " produkter"; // Filtrering er færdigt = Skriver antalProdukter + " produkter"
      });
    }
  </script>
</MainLayout>

<style>
  /* Styling på filterknap */
  .filterbutton.active {
    color: var(--color_blue);
  }

  /* id til javascript */
  .hide {
    display: none;
  }

  .hero_items {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 80px;
  }

  .produkter {
    display: grid;
    grid-template-columns: 1fr 1fr;
    justify-content: center;
    gap: 22px;
    margin-top: 10px;
  }

  .filter_ting {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .filter a:hover {
    color: var(--color_blue);
  }

  .filter {
    display: flex;
    align-items: center;
    text-decoration: none;
    overflow: hidden;
    margin: 5px 0;
    justify-content: center;
    cursor: pointer;
    gap: 15px;
    font-size: var(--font_size_regular);
  }
  .filter a,
  .filter_ting p {
    font-size: var(--font_size_regular);
    text-transform: uppercase;
  }

  /* Tablet */
  @media screen and (min-width: 768px) {
    h1 {
      text-align: start;
    }

    .breadcrumb_button {
      justify-content: space-between;
    }

    .produkter {
      grid-template-columns: 1fr 1fr 1fr;
      gap: 32px;
      margin-top: 20px;
    }
    .filter a,
    .filter_ting p {
      font-size: var(--font_size_regular);
    }
  }

  /* Desktop */
  @media screen and (min-width: 1024px) {
    .hero_items {
      padding-top: 125px;
    }
    .produkter {
      grid-template-columns: 1fr 1fr 1fr 1fr;
    }
    .filter a,
    .filter_ting p {
      font-size: var(--font_size_regular);
    }
  }
</style>
